# TMDB API key. Either a v3 API key (32 chars) or a v4 "API Read Access Token" (long JWT).
# Get one at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Supabase (optional): syncs ratings and the watchlist across devices. Without these the app
# stores everything in this browser only. Find both at Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
